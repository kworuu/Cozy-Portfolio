<div class="mb-8">
    <span class="text-xs font-extrabold uppercase tracking-[2px]" style="color: @EyebrowColor;">@Eyebrow</span>
    <h2 class="my-1 text-[2.2rem] font-extrabold">@Title</h2>
    <div class="mt-2 h-0.5 w-full max-w-[300px] bg-beige"></div>
</div>

@code {
    [Parameter, EditorRequired] public string Eyebrow { get; set; } = string.Empty;
    [Parameter] public string EyebrowColor { get; set; } = "var(--color-bark)";
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
}