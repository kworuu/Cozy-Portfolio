<div class="flex flex-col gap-4 rounded-3xl border-[3px] border-beige bg-white p-6 shadow-pop transition-transform duration-100 hover:-translate-y-1">
    <div class="flex items-center gap-3">
        <span class="inline-flex items-center justify-center rounded-full bg-cream p-2 text-sage"><Icon Name="Project.Icon" Size="20" /></span>
        <h3 class="text-[1.3rem] font-extrabold">@Project.Title</h3>
    </div>
    <p class="grow text-[0.9rem] leading-normal text-bark">@Project.Description</p>
    <div class="flex flex-wrap gap-2">
        @foreach (var tag in Project.Tags)
        {
            <span class="rounded-2xl bg-mint px-2.5 py-1 text-xs font-bold text-soil">@tag</span>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public Project Project { get; set; } = default!;
}