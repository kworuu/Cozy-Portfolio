@page "/projects"

<section class="portfolio-section">
    <div class="section-header">
        <span class="eyebrow" style="color: var(--color-sage);">📌 PINNED WORK</span>
        <h2>Projects</h2>
        <div class="divider"></div>
    </div>
    
    <div class="projects-grid">
        @foreach (var proj in MyProjects)
        {
            <div class="project-card">
                <div class="card-title">
                    <span class="card-icon">@proj.Icon</span>
                    <h3>@proj.Title</h3>
                </div>
                <p>@proj.Description</p>
                <div class="tags">
                    @foreach (var tag in proj.Tags)
                    {
                        <span class="tag">@tag</span>
                    }
                </div>
            </div>
        }
    </div>
</section>

@code {
    [Inject] private IportfolioDataService DataService { get; set; } = default!;
    private IReadOnlyList<Project> MyProjects = Array.Empty<Project>();

    protected override void OnInitialized()
    {
        MyProjects = DataService.GetProjects();
    }
}