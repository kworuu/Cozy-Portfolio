@page "/projects"

<section>
    <SectionHeader Eyebrow="📌 PINNED WORK" EyebrowColor="var(--color-sage)" Title="Projects" />

    <div class="mt-6 grid grid-cols-[repeat(auto-fit,minmax(260px,1fr))] gap-6">
        @foreach (var proj in MyProjects)
        {
            <ProjectCard Project="proj" />
        }
    </div>
</section>

@code {
    [Inject] private IPortfolioDataService DataService { get; set; } = default!;

    private IReadOnlyList<Project> MyProjects = Array.Empty<Project>();

    protected override void OnInitialized()
    {
        MyProjects = DataService.GetProjects();
    }
}