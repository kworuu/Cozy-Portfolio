@page "/skills"

<section class="portfolio-section">
    <div class="section-header">
        <span class="eyebrow" style="color: var(--color-sky);">🎒 MY TOOLKIT</span>
        <h2>Skills & Tools</h2>
        <div class="divider"></div>
    </div>
    
    <div class="skills-flex">
        @foreach (var skill in MySkills)
        {
            <div class="skill-pill">
                <span class="skill-icon">@skill.Icon</span>
                <span>@skill.Name</span>
            </div>
        }
    </div>
</section>

@code {
    [Inject] private IPortfolioDataService DataService { get; set; } = default!;

    private IReadOnlyList<Skill> MySkills = Array.Empty<Skill>();

    protected override void OnInitialized()
    {
        MySkills = DataService.GetSkills();
    }
}