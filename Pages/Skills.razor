@page "/skills"

<section>
    <SectionHeader Eyebrow="🎒 MY TOOLKIT" EyebrowColor="var(--color-sky)" Title="Skills & Tools" />

    <div class="mt-6 flex flex-wrap gap-[0.8rem]">
        @foreach (var skill in MySkills)
        {
            <SkillPill Skill="skill" />
        }
    </div>
</section>

@code {
    [Inject] private IPortfolioDataService DataService { get; set; } = default!;

    private IReadOnlyList<Skill> MySkills = Array.Empty<Skill>();

    protected override void OnInitialized()
    {
        MySkills = DataService.GetSkills();
    }
}